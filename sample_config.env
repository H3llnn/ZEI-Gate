# Bot induk dari BotFather; jangan isi token bot anak di sini.
MASTER_BOT_TOKEN=
# ID pengguna Telegram pemilik bot induk (angka positif).
MASTER_OWNER_ID=
# Hasil python -m subgate.keygen; simpan secara privat dan cadangkan.
SECRET_KEY=
# Disk persisten; jangan memakai direktori sementara.
DATA_DIR=./data

# Payment cukup diatur lewat username Saweria pada /setting bot anak.
# Tidak memerlukan PAYMENT_PUBLIC_BASE, stream key atau tunnel.

# Formulir pembuatan untuk ForceSubs / Payment / Userbot (opsional).
# Aktifkan setelah memasang kedua proyek melalui python install.py.
CREATION_ENABLE=0
# Origin HTTPS milik servermu, tanpa path. Mini App perlu HTTPS.
CREATION_PUBLIC_BASE=
CREATION_BIND=127.0.0.1
CREATION_PORT=8081
# Aktifkan inline mode bot induk di BotFather untuk tombol .help.
# ForceSubs/Payment yang lama tetap bekerja tanpa formulir web.
